# MaxSeller server configuration
PORT=3001
STORE_URL=http://localhost:3001/
JWT_SECRET=change-this-to-a-long-random-secret-in-production
OTP_SECRET=change-this-to-another-long-random-secret
ADMIN_PASSWORD=admin123

# Telegram admin (admin bot notification target)
TELEGRAM_ADMIN_USERNAME=madaliyev_a
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_IDS=

# Bot tokenlari — FAQAT backend. Frontendga hech qachon yuborilmaydi.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_TOKEN=

# polling | webhook
TELEGRAM_MODE=polling
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# OTP xavfsizligi
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Telefon/SMS OTP butunlay o'chirilgan. Faqat email orqali kod yuboriladi.
# SMS provayderi ishlatilmaydi (eskiz/twilio kalitlari kerak emas).
SMS_PROVIDER=

# Email provayderi: gmail | smtp | resend | (bo'sh = o'chirilgan, soxta yuborish yo'q)
# Bepul va API keysiz: Gmail app password. Google Account → Security → 2-Step Verification → App passwords.
EMAIL_PROVIDER=gmail
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=MaxSeller <youraccount@gmail.com>

# Oddiy SMTP server (EMAIL_PROVIDER=smtp bo'lganda ishlatiladi)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Faqat mahalliy proxy o'z sertifikatini ishlatayotganda false qiling; productionda true.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Resend (ixtiyoriy, API key bilan; EMAIL_PROVIDER=resend bo'lganda)
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com

# Payment providers (ixtiyoriy; credentials bo'lmaganda ishlamaydi)
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Fayl cheklovlari (MB)
MAX_IMAGE_MB=4
MAX_PRODUCT_FILE_MB=20
