generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIPT_SUBMITTED
  PAYMENT_REVIEW
  PAID
  COMPLETED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PENDING_REVIEW
  PAID
  FAILED
  REFUNDED
  REJECTED
}

enum VerificationAction {
  APPROVE
  REJECT
  REQUEST_RECEIPT
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationType {
  ORDER
  PAYMENT
  CUSTOMER
  SYSTEM
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  admins      Admin[]
  createdAt   DateTime @default(now())
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  role         UserRole      @default(CUSTOMER)
  isActive     Boolean       @default(true)
  roleId       String?
  roleRef      Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
  notifications Notification[]
  downloads    Download[]
  couponUsages CouponUsage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([createdAt])
}

model Admin {
  id          String        @id @default(uuid())
  name        String
  email       String        @unique
  passwordHash String
  role        UserRole      @default(ADMIN)
  isActive    Boolean       @default(true)
  roleId      String?
  roleRef     Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  verifications PaymentVerification[]
  activities  ActivityLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  nameUz      String
  slug        String    @unique
  description String    @default("")
  imageUrl    String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  shortDescription String        @default("")
  description     String         @default("")
  price           Float          @default(0)
  oldPrice        Float          @default(0)
  currency        String         @default("so'm")
  status          ProductStatus  @default(DRAFT)
  featured        Boolean        @default(false)
  bestSeller      Boolean        @default(false)
  views           Int            @default(0)
  sales           Int            @default(0)
  features        String[]       @default([])
  requirements    String         @default("")
  compatibility   String         @default("")
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  files           ProductFile[]
  orderItems      OrderItem[]
  downloads       Download[]
  reviews         Review[]
  favorites       Favorite[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([featured, status])
  @@index([bestSeller, status])
  @@index([price])
}

model ProductImage {
  id          String   @id @default(uuid())
  url         String
  alt         String   @default("")
  sortOrder   Int      @default(0)
  storagePath String?
  mimeType    String?
  // Null bo'lsa — admin yuklagan, lekin hali mahsulotga biriktirilmagan vaqtinchalik rasm
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductFile {
  id          String   @id @default(uuid())
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  // Null bo'lsa — admin yuklagan, lekin hali mahsulotga biriktirilmagan fayl
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model Order {
  id            String            @id @default(uuid())
  orderNumber   String            @unique
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  subtotal      Float
  discount      Float             @default(0)
  total         Float
  status        OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus     @default(PENDING)
  payment       Payment?
  receipts      PaymentReceipt[]
  verifications PaymentVerification[]
  transactions  Transaction[]
  notifications Notification[]
  customerNote  String?
  adminNote     String?
  couponId      String?
  coupon        Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  downloads     Download[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productTitle String
  productSlug  String
  productImage String?
  unitPrice    Float
  quantity     Int     @default(1)
  totalPrice   Float

  @@index([orderId])
  @@index([productId])
}

model PaymentMethod {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  instructions     String
  recipientDetails String
  qrUrl            String?
  linkUrl          String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  payments         Payment[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  methodId      String?
  method        PaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  methodName    String?
  amount        Float
  currency      String        @default("so'm")
  status        PaymentStatus @default(PENDING)
  transactionId String?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model PaymentReceipt {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storagePath  String
  uploadedById String?
  isLatest     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
}

model PaymentVerification {
  id        String            @id @default(uuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    VerificationAction
  reason    String?
  adminId   String
  admin     Admin             @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt DateTime          @default(now())

  @@index([orderId, createdAt])
}

model Download {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId      String
  fileName    String
  size        Int
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId, productId])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, isApproved])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Coupon {
  id          String        @id @default(uuid())
  code        String        @unique
  type        CouponType
  value       Float
  minOrder    Float         @default(0)
  isActive    Boolean       @default(true)
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int           @default(0)
  orders      Order[]
  usages      CouponUsage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Transaction {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      String
  amount    Float
  status    String
  reference String?
  details   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  channel   String           @default("IN_APP")
  isRead    Boolean          @default(false)
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName  String?
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("FAQ")
  @@index([isActive, sortOrder])
}
