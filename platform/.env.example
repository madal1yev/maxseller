# ============ DATABASE ============
DATABASE_URL="postgresql://maxseller:maxseller@localhost:5432/maxseller?schema=public"
# Test uchun PGlite (real Postgres WASM) — faqat local testlarda ishlatiladi
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55433/postgres?schema=public&connection_limit=1"

# ============ API ============
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@maxseller.uz"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="MaxSeller Admin"

# ============ PRIVATE STORAGE ============
# local yoki s3 (s3 driver interfeysi tayyor, provider credentials kelganda ulanadi)
STORAGE_DRIVER=local
STORAGE_DIR="./storage"
MAX_RECEIPT_MB=5
MAX_PRODUCT_FILE_MB=200
MAX_IMAGE_MB=5

# ============ SMS (ixtiyoriy) ============
# none | generic | twilio
SMS_PROVIDER=none
SMS_API_URL=""
SMS_API_KEY=""
SMS_FROM=""
ADMIN_PHONE="+998900000000"
SMS_RETRY_ATTEMPTS=3

# ============ TELEGRAM BOT (ixtiyoriy) ============
# Bu @maxseller_uz kanal emas, alohida bot token
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ============ PAYMENT PROVIDERS (kelajak uchun) ============
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# ============ FRONTEND (NEXT_PUBLIC — faqat ochiq ma'lumot) ============
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_CHANNEL="maxseller_uz"
